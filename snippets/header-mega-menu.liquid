{% comment %}
  Modern on-hover floating mega menu.
  Renders categorized columns of links with headers and sublinks,
  along with an optional promotional card/banner on the right side.
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu mega-menu--modern">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
                aria-haspopup="true"
                data-mega-parent-url="{{ link.url }}"
              >
                <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
              </summary>

              {%- liquid
                assign promo_block = nil
                assign link_title_clean = link.title | downcase | strip
                for block in blocks
                  if block.type == 'mega_menu_promo'
                    assign block_title_clean = block.settings.menu_title | downcase | strip
                    if block_title_clean == link_title_clean
                      assign promo_block = block
                      break
                    endif
                  endif
                endfor

                assign has_promo = false
                if promo_block != nil and promo_block.settings.promo_image != blank
                  assign has_promo = true
                elsif link.type == 'collection_link' and link.object.image != blank
                  assign has_promo = true
                endif
              -%}

              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content mega-menu__content--floating color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="mega-menu__card-body">
                  <div class="mega-menu__main-layout{% if has_promo %} mega-menu__main-layout--with-promo{% endif %}">
                    <div class="mega-menu__categories-columns">
                      {%- for childlink in link.links -%}
                        <div class="mega-menu__category-block">
                          <a href="{{ childlink.url }}" class="mega-menu__category-title">
                            {{ childlink.title | escape }}
                          </a>
                          {%- if childlink.links != blank -%}
                            <ul class="mega-menu__sublist list-unstyled" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li>
                                  <a href="{{ grandchildlink.url }}" class="mega-menu__sublink">
                                    {{ grandchildlink.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>

                    {%- if has_promo -%}
                      <div class="mega-menu__promo-container">
                        {%- if promo_block != nil and promo_block.settings.promo_image != blank -%}
                          {%- if promo_block.settings.promo_link != blank -%}
                            <a href="{{ promo_block.settings.promo_link }}" class="mega-menu__promo-card-link">
                          {%- else -%}
                            <div class="mega-menu__promo-card-link">
                          {%- endif -%}
                            <div class="mega-menu__promo-card">
                              <div class="mega-menu__promo-image-wrapper">
                                {{
                                  promo_block.settings.promo_image
                                  | image_url: width: 800
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '240, 360, 500, 800',
                                    sizes: '280px',
                                    alt: promo_block.settings.promo_heading | default: promo_block.settings.promo_image.alt | default: link.title,
                                    class: 'mega-menu__promo-image'
                                }}
                              </div>
                              {%- if promo_block.settings.promo_heading != blank or promo_block.settings.promo_subtext != blank -%}
                                <div class="mega-menu__promo-text-wrap">
                                  {%- if promo_block.settings.promo_heading != blank -%}
                                    <h4 class="mega-menu__promo-heading">{{ promo_block.settings.promo_heading | escape }}</h4>
                                  {%- endif -%}
                                  {%- if promo_block.settings.promo_subtext != blank -%}
                                    <p class="mega-menu__promo-subtext">{{ promo_block.settings.promo_subtext | escape }}</p>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                            </div>
                          {%- if promo_block.settings.promo_link != blank -%}
                            </a>
                          {%- else -%}
                            </div>
                          {%- endif -%}
                        {%- elsif link.type == 'collection_link' and link.object.image != blank -%}
                          <a href="{{ link.url }}" class="mega-menu__promo-card-link">
                            <div class="mega-menu__promo-card">
                              <div class="mega-menu__promo-image-wrapper">
                                {{
                                  link.object.image
                                  | image_url: width: 800
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '240, 360, 500, 800',
                                    sizes: '280px',
                                    alt: link.object.title,
                                    class: 'mega-menu__promo-image'
                                }}
                              </div>
                              <div class="mega-menu__promo-text-wrap">
                                <h4 class="mega-menu__promo-heading">{{ link.object.title | escape }}</h4>
                              </div>
                            </div>
                          </a>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span{% if link.current %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>