{% comment %}
  Renders collection-switching pills from a navigation menu.
  Accepts: links, current_collection, show_all, all_label, colors.
{% endcomment %}

<nav
  class="collection-switcher"
  aria-label="Collection navigation"
  style="--collection-tab-text: {{ text_color }}; --collection-tab-border: {{ border_color }}; --collection-tab-active-bg: {{ active_background }}; --collection-tab-active-text: {{ active_text_color }};"
>
  <div class="collection-switcher__track">
    {%- for link in links -%}
      {%- assign is_active = false -%}
      {%- if link.current or link.object.handle == current_collection.handle -%}
        {%- assign is_active = true -%}
      {%- endif -%}
      <a
        class="collection-switcher__tab{% if is_active %} is-active{% endif %}"
        href="{{ link.url }}"
        {% if is_active %}aria-current="page"{% endif %}
      >
        {{ link.title | escape }}
      </a>
    {%- endfor -%}

    {%- if show_all -%}
      {%- assign all_active = false -%}
      {%- if current_collection.handle == 'all' -%}{%- assign all_active = true -%}{%- endif -%}
      <a
        class="collection-switcher__tab{% if all_active %} is-active{% endif %}"
        href="{{ routes.all_products_collection_url }}"
        {% if all_active %}aria-current="page"{% endif %}
      >
        {{ all_label | escape }}
      </a>
    {%- endif -%}
  </div>
</nav>