{% comment %} Mobile collection mega menu {% endcomment %}

{%- liquid
  assign mobile_mega_parent = blank
  for top_link in section.settings.menu.links
    if top_link.links != blank
      assign mobile_mega_parent = top_link
      break
    endif
  endfor
-%}

{%- if mobile_mega_parent != blank -%}
  <div class="mobile-mega" data-mobile-mega>
    <div class="mobile-mega__tabs" role="tablist" aria-label="{{ mobile_mega_parent.title | escape }} collections">
      {%- for childlink in mobile_mega_parent.links -%}
        <button class="mobile-mega__tab{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-mobile-mega-tab>
          {{ childlink.title | escape }}
        </button>
      {%- endfor -%}
    </div>

    <div class="mobile-mega__panes">
      {%- for childlink in mobile_mega_parent.links -%}
        {%- assign child_collection = childlink.object -%}
        <section class="mobile-mega__pane{% if forloop.first %} is-active{% endif %}" data-mobile-mega-pane {% unless forloop.first %}hidden{% endunless %}>
          {%- if childlink.type == 'collection_link' and child_collection != blank -%}
            <div class="mobile-mega__products">
              {%- for product in child_collection.products limit: 4 -%}
                {%- assign preview_text = product.metafields.custom.featured_card_metadata.value | default: product.description -%}
                {%- assign product_badge = product.metafields.custom.featured_card_badge.value -%}
                <a class="mobile-mega__product{% if product_badge != blank %} mobile-mega__product--has-badge{% endif %}" href="{{ product.url }}">
                  <span class="mobile-mega__image">
                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '56px', alt: product.featured_image.alt | default: product.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </span>
                  <span class="mobile-mega__copy">
                    <strong>{{ product.title | escape }}</strong>
                    {%- if preview_text != blank -%}<span>{{ preview_text | strip_html | truncate: 52 }}</span>{%- endif -%}
                  </span>
                  {%- if product_badge != blank -%}
                    <span class="mobile-mega__badge">{{ product_badge | escape }}</span>
                  {%- endif -%}
                </a>
              {%- else -%}
                <p class="mobile-mega__empty">No products found in this collection.</p>
              {%- endfor -%}
            </div>
            {%- if child_collection.products_count > 4 -%}
              <a class="mobile-mega__view-all" href="{{ child_collection.url }}">VIEW {{ childlink.title | escape }}</a>
            {%- endif -%}
          {%- else -%}
            <a class="mobile-mega__fallback-link" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
          {%- endif -%}
        </section>
      {%- endfor -%}
    </div>

    <div class="mobile-mega__secondary-links">
      {%- for top_link in section.settings.menu.links -%}
        {%- unless top_link.handle == mobile_mega_parent.handle -%}
          <a href="{{ top_link.url }}">{{ top_link.title | escape }}</a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}