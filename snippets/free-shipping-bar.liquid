{% comment %}
  Renders a Free Shipping progress bar for cart drawer and cart page.
{% endcomment %}
{%- if settings.show_free_shipping_bar -%}
  {%- liquid
    assign threshold_num = settings.free_shipping_threshold | default: 50 | times: 1.0
    assign threshold_cents = threshold_num | times: 100
    assign cart_total = cart.total_price
    assign progress_percent = cart_total | times: 100.0 | divided_by: threshold_cents
    if progress_percent > 100
      assign progress_percent = 100
    endif
    assign amount_left = threshold_cents | minus: cart_total
  -%}

  <div class="free-shipping-bar" data-threshold="{{ threshold_cents }}" id="FreeShippingBar">
    <div class="free-shipping-bar__message">
      {%- if cart_total >= threshold_cents -%}
        <span class="free-shipping-bar__success">
          <svg class="free-shipping-bar__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          Congratulations! You've qualified for FREE Shipping! 🎉
        </span>
      {%- else -%}
        <span class="free-shipping-bar__progress-text">
          <svg class="free-shipping-bar__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          Add <strong>{{ amount_left | money }}</strong> more to unlock <strong>FREE Shipping</strong>!
        </span>
      {%- endif -%}
    </div>
    <div class="free-shipping-bar__track">
      <div
        class="free-shipping-bar__fill"
        style="width: {{ progress_percent }}%;"
        role="progressbar"
        aria-valuenow="{{ progress_percent | round }}"
        aria-valuemin="0"
        aria-valuemax="100"
      ></div>
    </div>
  </div>
{%- endif -%}
