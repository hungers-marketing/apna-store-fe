{%- liquid
  assign question_id = 'HungersFaqQuestion-' | append: section_id | append: '-' | append: block.id
  assign answer_id = 'HungersFaqAnswer-' | append: section_id | append: '-' | append: block.id
-%}

<div class="hungers-faqs__item" {{ block.shopify_attributes }}>
  <button
    type="button"
    id="{{ question_id }}"
    class="hungers-faqs__question"
    aria-expanded="false"
    aria-controls="{{ answer_id }}"
  >
    <span>{{ block.settings.question }}</span>
    <span class="hungers-faqs__icon" aria-hidden="true">+</span>
  </button>
  <div id="{{ answer_id }}" class="hungers-faqs__answer" role="region" aria-labelledby="{{ question_id }}" hidden>
    <p>{{ block.settings.answer | escape | newline_to_br }}</p>
  </div>
</div>
