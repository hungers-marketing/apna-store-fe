<div class="rounded-section">
  <section
    id="HungersIngredients-{{ section.id }}"
    class="hungers-ingredients rounded-section__inner"
    style="--hi-section-bg: {{ section.settings.section_background }}; --hi-card-bg: {{ section.settings.card_background }}; --hi-heading-color: {{ section.settings.heading_color }}; --hi-description-color: {{ section.settings.description_color }}; --hi-subheading-color: {{ section.settings.subheading_color }}; --hi-name-color: {{ section.settings.name_color }}; --hi-link-color: {{ section.settings.link_color }}; --hi-link-hover-color: {{ section.settings.link_hover_color }}; --hi-arrow-bg: {{ section.settings.arrow_background }}; --hi-arrow-color: {{ section.settings.arrow_color }}; --hi-arrow-border: {{ section.settings.arrow_border_color }}; --hi-track-color: {{ section.settings.progress_track_color }}; --hi-progress-color: {{ section.settings.progress_color }}; --hi-heading-desktop: {{ section.settings.heading_size_desktop }}px; --hi-heading-mobile: {{ section.settings.heading_size_mobile }}px; --hi-description-size: {{ section.settings.description_size }}px; --hi-subheading-size: {{ section.settings.subheading_size }}px; --hi-name-size: {{ section.settings.name_size }}px; --hi-link-size: {{ section.settings.link_size }}px; --hi-card-width-desktop: {{ section.settings.card_width_desktop }}%; --hi-card-width-tablet: {{ section.settings.card_width_tablet }}%; --hi-card-width-mobile: {{ section.settings.card_width_mobile }}%; --hi-card-gap: {{ section.settings.card_gap }}px; --hi-image-height: {{ section.settings.image_height }}px; --hi-image-fit: {{ section.settings.image_fit }}; --hi-card-radius: {{ section.settings.card_radius }}px; --hi-content-padding-desktop: {{ section.settings.content_padding_desktop }}px; --hi-content-padding-mobile: {{ section.settings.content_padding_mobile }}px; --hi-padding-top: {{ section.settings.padding_top }}px; --hi-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="hungers-ingredients__container">
      {%- if section.settings.section_heading != blank -%}
        <h2 class="hungers-ingredients__title">{{ section.settings.section_heading }}</h2>
      {%- endif -%}

      <div class="hungers-ingredients__slider-wrapper">
        <button
          type="button"
          class="hungers-ingredients__arrow hungers-ingredients__arrow--left"
          aria-label="Previous ingredients"
          data-ingredients-previous
        >
          <span aria-hidden="true">‹</span>
        </button>

        <div
          class="hungers-ingredients__slider"
          role="list"
          aria-label="{{ section.settings.section_heading | escape }}"
          data-ingredients-slider
        >
          {%- for block in section.blocks -%}
            <article class="hungers-ingredients__card" role="listitem" {{ block.shopify_attributes }}>
              <div class="hungers-ingredients__image">
                {%- if block.settings.ingredient_image != blank -%}
                  {{
                    block.settings.ingredient_image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '320, 480, 640, 900, 1200',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 90vw',
                      loading: 'lazy',
                      alt: block.settings.ingredient_name
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="hungers-ingredients__card-content">
                {%- if block.settings.ingredient_description != blank -%}
                  <p class="hungers-ingredients__description">{{ block.settings.ingredient_description }}</p>
                {%- endif -%}
                {%- if block.settings.ingredient_subheading != blank -%}
                  <p class="hungers-ingredients__subheading">{{ block.settings.ingredient_subheading }}</p>
                {%- endif -%}
                {%- if block.settings.ingredient_name != blank -%}
                  <h3 class="hungers-ingredients__name">{{ block.settings.ingredient_name }}</h3>
                {%- endif -%}
                {%- if block.settings.ingredient_link != blank -%}
                  <a class="hungers-ingredients__link" href="{{ block.settings.ingredient_link }}">
                    {{ section.settings.link_label }} <span aria-hidden="true">→</span>
                  </a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="hungers-ingredients__arrow hungers-ingredients__arrow--right"
          aria-label="Next ingredients"
          data-ingredients-next
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="hungers-ingredients__progress" aria-hidden="true">
          <div class="hungers-ingredients__progress-track">
            <span class="hungers-ingredients__progress-active" data-ingredients-progress></span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% style %}
  #HungersIngredients-{{ section.id }} {
    width: 100%;
    padding-block: var(--hi-padding-top) var(--hi-padding-bottom);
    overflow: hidden;
    color: var(--hi-name-color);
    background: var(--hi-section-bg);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__container {
    width: 100%;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__title {
    margin: 0 0 2.4rem;
    padding-inline: var(--hi-content-padding-desktop);
    color: var(--hi-heading-color);
    font-size: var(--hi-heading-desktop);
    font-weight: 700;
    line-height: 1.2;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__slider-wrapper {
    position: relative;
    width: 100%;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__slider {
    display: flex;
    width: 100%;
    gap: var(--hi-card-gap);
    padding: 0 var(--hi-content-padding-desktop) 0.6rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--hi-content-padding-desktop);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__slider::-webkit-scrollbar {
    display: none;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__slider.is-dragging {
    scroll-behavior: auto;
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__card {
    flex: 0 0 var(--hi-card-width-desktop);
    min-width: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border-radius: var(--hi-card-radius);
    background: var(--hi-card-bg);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__image {
    width: 100%;
    height: var(--hi-image-height);
    overflow: hidden;
    border-radius: var(--hi-card-radius);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__image img,
  #HungersIngredients-{{ section.id }} .hungers-ingredients__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--hi-image-fit);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__card-content {
    padding: 1.4rem;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__description,
  #HungersIngredients-{{ section.id }} .hungers-ingredients__subheading,
  #HungersIngredients-{{ section.id }} .hungers-ingredients__name {
    margin: 0;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__description {
    margin-bottom: 0.4rem;
    color: var(--hi-description-color);
    font-size: var(--hi-description-size);
    font-weight: 400;
    line-height: 1.35;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__subheading {
    margin-bottom: 0.6rem;
    color: var(--hi-subheading-color);
    font-size: var(--hi-subheading-size);
    font-weight: 500;
    line-height: 1.3;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__name {
    margin-bottom: 0.6rem;
    color: var(--hi-name-color);
    font-size: var(--hi-name-size);
    font-weight: 700;
    line-height: 1.3;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.2rem;
    color: var(--hi-link-color);
    font-size: var(--hi-link-size);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__link:hover {
    color: var(--hi-link-hover-color);
    transform: translateX(0.4rem);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    padding: 0;
    border: 0.1rem solid var(--hi-arrow-border);
    border-radius: 50%;
    color: var(--hi-arrow-color);
    background: var(--hi-arrow-bg);
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.06);
    font: inherit;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow:hover {
    transform: translateY(-50%) scale(1.05);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow--left {
    left: 0.8rem;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow--right {
    right: 0.8rem;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__progress {
    padding: 0 var(--hi-content-padding-desktop);
    margin-top: 1.8rem;
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__progress-track {
    position: relative;
    width: 100%;
    height: 0.2rem;
    overflow: hidden;
    border-radius: var(--radius-pill, 999px);
    background: var(--hi-track-color);
  }

  #HungersIngredients-{{ section.id }} .hungers-ingredients__progress-active {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 10%;
    border-radius: inherit;
    background: var(--hi-progress-color);
    transform-origin: left center;
    transition: width 0.15s linear, left 0.15s linear;
  }

  @media screen and (max-width: 989px) {
    #HungersIngredients-{{ section.id }} .hungers-ingredients__card {
      flex-basis: var(--hi-card-width-tablet);
    }
  }

  @media screen and (max-width: 749px) {
    #HungersIngredients-{{ section.id }} .hungers-ingredients__title {
      padding-inline: var(--hi-content-padding-mobile);
      font-size: var(--hi-heading-mobile);
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__slider {
      padding-inline: var(--hi-content-padding-mobile);
      scroll-padding-inline: var(--hi-content-padding-mobile);
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__card {
      flex-basis: var(--hi-card-width-mobile);
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow {
      width: 3.6rem;
      height: 3.6rem;
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow--left {
      left: 0.4rem;
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__arrow--right {
      right: 0.4rem;
    }

    #HungersIngredients-{{ section.id }} .hungers-ingredients__progress {
      padding-inline: var(--hi-content-padding-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #HungersIngredients-{{ section.id }} .hungers-ingredients__slider {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('HungersIngredients-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;

    const slider = section.querySelector('[data-ingredients-slider]');
    const previous = section.querySelector('[data-ingredients-previous]');
    const next = section.querySelector('[data-ingredients-next]');
    const progress = section.querySelector('[data-ingredients-progress]');
    if (!slider || !previous || !next) return;

    const updateControls = () => {
      const maxScroll = Math.max(0, slider.scrollWidth - slider.clientWidth);
      const ratio = slider.scrollWidth > 0 ? Math.min(1, slider.clientWidth / slider.scrollWidth) : 1;
      const thumbPercent = Math.max(8, ratio * 100);
      const travelPercent = 100 - thumbPercent;
      const scrollPercent = maxScroll > 0 ? slider.scrollLeft / maxScroll : 0;

      previous.disabled = slider.scrollLeft <= 1;
      next.disabled = slider.scrollLeft >= maxScroll - 1;

      if (progress) {
        progress.style.width = `${thumbPercent}%`;
        progress.style.left = `${scrollPercent * travelPercent}%`;
      }
    };

    const scrollByCard = (direction) => {
      const card = slider.querySelector('.hungers-ingredients__card');
      const styles = window.getComputedStyle(slider);
      const gap = parseFloat(styles.columnGap || styles.gap) || 0;
      const distance = card ? card.getBoundingClientRect().width + gap : slider.clientWidth * 0.8;
      slider.scrollBy({ left: distance * direction, behavior: 'smooth' });
    };

    previous.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
    slider.addEventListener('scroll', updateControls, { passive: true });

    let dragging = false;
    let startX = 0;
    let startScroll = 0;

    slider.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'touch') return;
      dragging = true;
      startX = event.clientX;
      startScroll = slider.scrollLeft;
      slider.classList.add('is-dragging');
      slider.setPointerCapture(event.pointerId);
    });

    slider.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      slider.scrollLeft = startScroll - (event.clientX - startX) * 1.2;
    });

    const stopDragging = (event) => {
      if (!dragging) return;
      dragging = false;
      slider.classList.remove('is-dragging');
      if (slider.hasPointerCapture(event.pointerId)) slider.releasePointerCapture(event.pointerId);
    };

    slider.addEventListener('pointerup', stopDragging);
    slider.addEventListener('pointercancel', stopDragging);
    slider.addEventListener('dragstart', (event) => event.preventDefault());

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(updateControls);
      observer.observe(slider);
    } else {
      window.addEventListener('resize', updateControls, { passive: true });
    }

    updateControls();
    section.dataset.initialized = 'true';
  })();
</script>

{% schema %}
{
  "name": "Hungers Ingredients",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "section_heading", "label": "Section heading", "default": "Ingredients (A–F)" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn More" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_width_desktop", "min": 20, "max": 50, "step": 1, "unit": "%", "label": "Desktop card width", "default": 25 },
    { "type": "range", "id": "card_width_tablet", "min": 30, "max": 80, "step": 1, "unit": "%", "label": "Tablet card width", "default": 40 },
    { "type": "range", "id": "card_width_mobile", "min": 70, "max": 100, "step": 1, "unit": "%", "label": "Mobile card width", "default": 100 },
    { "type": "range", "id": "card_gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Space between cards", "default": 20 },
    { "type": "range", "id": "image_height", "min": 180, "max": 600, "step": 20, "unit": "px", "label": "Image height", "default": 360 },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card corner radius", "default": 8 },
    { "type": "range", "id": "content_padding_desktop", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Desktop side padding", "default": 56 },
    { "type": "range", "id": "content_padding_mobile", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Mobile side padding", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_desktop", "min": 16, "max": 60, "step": 2, "unit": "px", "label": "Desktop heading size", "default": 28 },
    { "type": "range", "id": "heading_size_mobile", "min": 14, "max": 40, "step": 2, "unit": "px", "label": "Mobile heading size", "default": 24 },
    { "type": "range", "id": "description_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Description size", "default": 13 },
    { "type": "range", "id": "subheading_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Subheading size", "default": 12 },
    { "type": "range", "id": "name_size", "min": 12, "max": 32, "step": 1, "unit": "px", "label": "Ingredient name size", "default": 17 },
    { "type": "range", "id": "link_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Link size", "default": 14 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "color", "id": "description_color", "label": "Description color", "default": "#6b6b6b" },
