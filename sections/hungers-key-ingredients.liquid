{% comment %} Hungers Key Ingredients Section by Hungers Marketing {% endcomment %}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign description_alpha = section.settings.description_overlay_opacity | divided_by: 100.0
  assign backdrop_alpha = section.settings.modal_backdrop_opacity | divided_by: 100.0
  assign overlay_background = section.settings.overlay_color | color_modify: 'alpha', overlay_alpha
  assign description_background = section.settings.description_overlay_color | color_modify: 'alpha', description_alpha
  assign backdrop_background = section.settings.modal_backdrop_color | color_modify: 'alpha', backdrop_alpha
-%}

<div class="rounded-section">
  <section
    id="HungersKeyIngredients-{{ section.id }}"
    class="hungers-key-ingredients rounded-section__inner"
    style="--hki-section-bg: {{ section.settings.section_background }}; --hki-heading-color: {{ section.settings.heading_color }}; --hki-list-color: {{ section.settings.list_button_color }}; --hki-list-border: {{ section.settings.list_button_border_color }}; --hki-card-text: {{ section.settings.card_text_color }}; --hki-overlay: {{ overlay_background }}; --hki-description-overlay: {{ description_background }}; --hki-modal-backdrop: {{ backdrop_background }}; --hki-modal-bg: {{ section.settings.modal_background }}; --hki-modal-text: {{ section.settings.modal_text_color }}; --hki-heading-desktop: {{ section.settings.heading_size_desktop }}px; --hki-heading-mobile: {{ section.settings.heading_size_mobile }}px; --hki-card-title-desktop: {{ section.settings.card_title_size_desktop }}px; --hki-card-title-mobile: {{ section.settings.card_title_size_mobile }}px; --hki-link-size: {{ section.settings.link_size }}px; --hki-description-size: {{ section.settings.description_size }}px; --hki-modal-heading-size: {{ section.settings.modal_heading_size }}px; --hki-modal-text-size: {{ section.settings.modal_text_size }}px; --hki-columns: {{ section.settings.columns_desktop }}; --hki-grid-gap: {{ section.settings.grid_gap }}px; --hki-card-height: {{ section.settings.card_height }}px; --hki-mobile-card-width: {{ section.settings.mobile_card_width }}%; --hki-card-radius: {{ section.settings.card_radius }}px; --hki-image-fit: {{ section.settings.image_fit }}; --hki-side-padding-desktop: {{ section.settings.side_padding_desktop }}px; --hki-side-padding-mobile: {{ section.settings.side_padding_mobile }}px; --hki-padding-top: {{ section.settings.padding_top }}px; --hki-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="hungers-key-ingredients__container">
      <header class="hungers-key-ingredients__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="hungers-key-ingredients__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.full_ingredients_text != blank -%}
          <button type="button" class="hungers-key-ingredients__list-button" data-open-ingredients-modal>
            {{ section.settings.list_button_label }}
          </button>
        {%- endif -%}
      </header>

      <div class="hungers-key-ingredients__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign ingredient_metafield = blank
            if product != blank and block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
              assign ingredient_metafield = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
            endif
          -%}
          <article
            class="hungers-key-ingredients__item"
            role="listitem"
            tabindex="0"
            aria-expanded="false"
            {{ block.shopify_attributes }}
          >
            <div class="hungers-key-ingredients__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '360, 550, 750, 900, 1200',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 85vw',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="hungers-key-ingredients__overlay">
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.link_url != blank -%}
                <a
                  href="{{ block.settings.link_url }}"
                  class="hungers-key-ingredients__learn-more"
                  {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  {{ section.settings.learn_more_label }}
                </a>
              {%- else -%}
                <button type="button" class="hungers-key-ingredients__learn-more" data-toggle-description>
                  {{ section.settings.learn_more_label }}
                </button>
              {%- endif -%}
            </div>

            <div class="hungers-key-ingredients__description" data-ingredient-description hidden>
              <button type="button" class="hungers-key-ingredients__description-close" aria-label="Close description" data-close-description>×</button>
              <div>
                {%- if ingredient_metafield != blank -%}
                  {{ ingredient_metafield | metafield_tag }}
                {%- else -%}
                  {{ block.settings.description | escape | newline_to_br }}
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>

    <div
      id="HungersIngredientsModal-{{ section.id }}"
      class="hungers-key-ingredients__modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="HungersIngredientsModalTitle-{{ section.id }}"
      data-ingredients-modal
      hidden
    >
      <div class="hungers-key-ingredients__modal-content">
        <button type="button" class="hungers-key-ingredients__modal-close" aria-label="Close ingredient list" data-close-ingredients-modal>×</button>
        <h3 id="HungersIngredientsModalTitle-{{ section.id }}">{{ section.settings.modal_heading }}</h3>
        <div class="rte">{{ section.settings.full_ingredients_text }}</div>
      </div>
    </div>
  </section>
</div>

{% style %}
  #HungersKeyIngredients-{{ section.id }} {
    width: 100%;
    padding: var(--hki-padding-top) var(--hki-side-padding-desktop) var(--hki-padding-bottom);
    overflow: visible;
    background: var(--hki-section-bg);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__container {
    width: 100%;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__heading {
    margin: 0;
    color: var(--hki-heading-color);
    font-size: var(--hki-heading-desktop);
    font-weight: 500;
    line-height: 1.2;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__list-button {
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 0.1rem solid var(--hki-list-border);
    color: var(--hki-list-color);
    background: transparent;
    font: inherit;
    font-size: 1.6rem;
    line-height: 1.3;
    letter-spacing: 0.1rem;
    cursor: pointer;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__grid {
    display: grid;
    grid-template-columns: repeat(var(--hki-columns), minmax(0, 1fr));
    gap: var(--hki-grid-gap);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__item {
    position: relative;
    height: var(--hki-card-height);
    overflow: hidden;
    border-radius: var(--hki-card-radius);
    scroll-snap-align: start;
    transition: transform 0.3s ease;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__item:focus-visible {
    outline: 0.2rem solid var(--hki-heading-color);
    outline-offset: 0.2rem;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__media,
  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__media img,
  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__media svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__media img,
  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__media svg {
    object-fit: var(--hki-image-fit);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__overlay,
  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__description {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    color: var(--hki-card-text);
    text-align: center;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__overlay {
    background: var(--hki-overlay);
    transition: background-color 0.3s ease;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__overlay h3 {
    margin: 0 0 1rem;
    color: inherit;
    font-size: var(--hki-card-title-desktop);
    font-weight: 600;
    line-height: 1.2;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__learn-more {
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: var(--hki-link-size);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__learn-more:hover {
    text-decoration: none;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__description {
    z-index: 2;
    background: var(--hki-description-overlay);
    font-size: var(--hki-description-size);
    line-height: 1.6;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__description[hidden] {
    display: none;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__description-close {
    position: absolute;
    top: 1.2rem;
    right: 1.5rem;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 2.8rem;
    line-height: 1;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__item:hover {
      transform: scale(1.02);
    }
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: var(--hki-modal-backdrop);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal[hidden] {
    display: none;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal-content {
    position: relative;
    width: min(100%, 70rem);
    max-height: min(80vh, 80rem);
    padding: 4rem;
    overflow-y: auto;
    border-radius: var(--radius-card, 10px);
    color: var(--hki-modal-text);
    background: var(--hki-modal-bg);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal-content h3 {
    margin: 0 0 1.5rem;
    color: inherit;
    font-size: var(--hki-modal-heading-size);
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal-content .rte {
    font-size: var(--hki-modal-text-size);
    line-height: 1.6;
  }

  #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal-close {
    position: absolute;
    top: 1.2rem;
    right: 1.8rem;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 3rem;
    line-height: 1;
    cursor: pointer;
  }

  @media screen and (max-width: 989px) {
    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    #HungersKeyIngredients-{{ section.id }} {
      padding-inline: var(--hki-side-padding-mobile);
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__header {
      flex-direction: column-reverse;
      align-items: center;
      margin-bottom: 3rem;
      text-align: center;
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__heading {
      font-size: var(--hki-heading-mobile);
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__list-button {
      font-size: 1.4rem;
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__grid {
      display: flex;
      gap: var(--hki-grid-gap);
      margin-inline: calc(var(--hki-side-padding-mobile) * -1);
      padding-inline: var(--hki-side-padding-mobile);
      overflow-x: auto;
      scroll-padding-inline: var(--hki-side-padding-mobile);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__grid::-webkit-scrollbar {
      display: none;
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__item {
      flex: 0 0 var(--hki-mobile-card-width);
      height: auto;
      aspect-ratio: 1 / 1;
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__overlay h3 {
      font-size: var(--hki-card-title-mobile);
    }

    #HungersKeyIngredients-{{ section.id }} .hungers-key-ingredients__modal-content {
      padding: 3.5rem 2rem 2.5rem;
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('HungersKeyIngredients-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;

    const items = section.querySelectorAll('.hungers-key-ingredients__item');
    const modal = section.querySelector('[data-ingredients-modal]');
    const openModalButton = section.querySelector('[data-open-ingredients-modal]');
    const closeModalButton = section.querySelector('[data-close-ingredients-modal]');
    let modalTrigger = null;

    const closeDescription = (item) => {
      const description = item.querySelector('[data-ingredient-description]');
      if (!description) return;
      description.hidden = true;
      item.setAttribute('aria-expanded', 'false');
    };

    const toggleDescription = (item) => {
      const description = item.querySelector('[data-ingredient-description]');
      if (!description) return;
      const shouldOpen = description.hidden;
      items.forEach((otherItem) => {
        if (otherItem !== item) closeDescription(otherItem);
      });
      description.hidden = !shouldOpen;
      item.setAttribute('aria-expanded', String(shouldOpen));
    };

    items.forEach((item) => {
      const toggle = item.querySelector('[data-toggle-description]');
      const close = item.querySelector('[data-close-description]');
      if (toggle) toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleDescription(item);
      });
      if (close) close.addEventListener('click', (event) => {
        event.stopPropagation();
        closeDescription(item);
      });
      item.addEventListener('click', (event) => {
        if (event.target.closest('a, button')) return;
        toggleDescription(item);
      });
      item.addEventListener('keydown', (event) => {
        if ((event.key === 'Enter' || event.key === ' ') && event.target === item) {
          event.preventDefault();
          toggleDescription(item);
        }
      });
    });

    const openModal = () => {
      if (!modal) return;
      modalTrigger = document.activeElement;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      closeModalButton?.focus();
    };

    const closeModal = () => {
      if (!modal) return;
      modal.hidden = true;
      document.body.style.overflow = '';
      modalTrigger?.focus();
    };

    openModalButton?.addEventListener('click', openModal);
    closeModalButton?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (event) => {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    section.dataset.initialized = 'true';
  })();
</script>

{% schema %}
{
  "name": "Hungers Key Ingredients",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key Ingredients" },
    { "type": "text", "id": "list_button_label", "label": "Full-list button", "default": "FULL INGREDIENT LIST" },
    { "type": "text", "id": "learn_more_label", "label": "Learn-more label", "default": "LEARN MORE" },
    { "type": "text", "id": "modal_heading", "label": "Modal heading", "default": "Full Ingredient List" },
    { "type": "richtext", "id": "full_ingredients_text", "label": "Full ingredient list", "default": "<p>Write your full ingredient list here...</p>" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "range", "id": "grid_gap", "min": 0, "max": 50, "step": 2, "unit": "px", "label": "Space between cards", "default": 24 },
    { "type": "range", "id": "card_height", "min": 240, "max": 600, "step": 20, "unit": "px", "label": "Desktop card height", "default": 380 },
    { "type": "range", "id": "mobile_card_width", "min": 65, "max": 100, "step": 1, "unit": "%", "label": "Mobile card width", "default": 80 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Card corner radius", "default": 8 },
    {
      "type": "select", "id": "image_fit", "label": "Image fit", "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    { "type": "range", "id": "side_padding_desktop", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Desktop side padding", "default": 0 },
    { "type": "range", "id": "side_padding_mobile", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Mobile side padding", "default": 0 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 60 },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_desktop", "min": 18, "max": 64, "step": 2, "unit": "px", "label": "Desktop heading size", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 44, "step": 2, "unit": "px", "label": "Mobile heading size", "default": 24 },
    { "type": "range", "id": "card_title_size_desktop", "min": 14, "max": 44, "step": 2, "unit": "px", "label": "Desktop card-title size", "default": 26 },
    { "type": "range", "id": "card_title_size_mobile", "min": 14, "max": 34, "step": 2, "unit": "px", "label": "Mobile card-title size", "default": 20 },
    { "type": "range", "id": "link_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Learn-more size", "default": 16 },
    { "type": "range", "id": "description_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Description size", "default": 16 },
    { "type": "range", "id": "modal_heading_size", "min": 16, "max": 44, "step": 2, "unit": "px", "label": "Modal heading size", "default": 24 },
    { "type": "range", "id": "modal_text_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Modal text size", "default": 16 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#2b2b2b" },
    { "type": "color", "id": "list_button_color", "label": "Full-list button color", "default": "#2b2b2b" },
    { "type": "color", "id": "list_button_border_color", "label": "Full-list underline", "default": "#bca67a" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#ffffff" },
    { "type": "color", "id": "overlay_color", "label": "Card overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Card overlay opacity", "default": 25 },
    { "type": "color", "id": "description_overlay_color", "label": "Description overlay color", "default": "#000000" },
    { "type": "range", "id": "description_overlay_opacity", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "Description overlay opacity", "default": 65 },
    { "type": "color", "id": "modal_background", "label": "Modal background", "default": "#ffffff" },
    { "type": "color", "id": "modal_text_color", "label": "Modal text color", "default": "#2b2b2b" },
    { "type": "color", "id": "modal_backdrop_color", "label": "Modal backdrop", "default": "#000000" },
    { "type": "range", "id": "modal_backdrop_opacity", "min": 20, "max": 90, "step": 5, "unit": "%", "label": "Modal backdrop opacity", "default": 60 }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ingredient image" },
        { "type": "text", "id": "title", "label": "Ingredient title", "default": "Key Ingredient" },
        { "type": "textarea", "id": "description", "label": "Manual description", "default": "Add an ingredient description here." },
        { "type": "url", "id": "link_url", "label": "Learn-more link (optional)" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open link in new tab", "default": false },
        { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace", "default": "custom" },
        { "type": "text", "id": "metafield_key", "label": "Metafield key", "default": "ingredient_description" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hungers Key Ingredients",
      "category": "Custom sections",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}
