{%- liquid
  assign display_image = section.settings.image_1
  if display_image == blank
    for block in section.blocks
      if block.settings.image != blank
        assign display_image = block.settings.image
        break
      endif
    endfor
  endif
-%}

<div class="rounded-section">
  <section
    id="HungersColumn-{{ section.id }}"
    class="hungers-column rounded-section__inner"
    style="--hc-heading-color: {{ section.settings.heading_color }}; --hc-text-color: {{ section.settings.text_color }}; --hc-hover-color: {{ section.settings.hover_color }}; --hc-section-bg: {{ section.settings.section_background }}; --hc-content-bg: {{ section.settings.content_background }}; --hc-item-bg: {{ section.settings.item_background }}; --hc-gap: {{ section.settings.column_gap }}px; --hc-heading-desktop: {{ section.settings.heading_size_desktop }}px; --hc-heading-mobile: {{ section.settings.heading_size_mobile }}px; --hc-text-desktop: {{ section.settings.text_size_desktop }}px; --hc-text-mobile: {{ section.settings.text_size_mobile }}px; --hc-item-desktop: {{ section.settings.item_size_desktop }}px; --hc-item-mobile: {{ section.settings.item_size_mobile }}px; --hc-padding-top: {{ section.settings.padding_top }}px; --hc-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="hungers-column__container">
      <div class="hungers-column__image">
        {%- if display_image != blank -%}
          {{
            display_image
            | image_url: width: 2400
            | image_tag:
              widths: '550, 750, 1100, 1500, 2000, 2400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.heading,
              class: 'hungers-column__main-image'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="hungers-column__content">
        <div class="hungers-column__top">
          {%- if section.settings.heading != blank -%}
            <h2 class="hungers-column__heading" data-main-heading>{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.desc_1 != blank -%}
            <div class="hungers-column__desc rte" data-main-description>{{ section.settings.desc_1 }}</div>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="hungers-column__bottom">
            {%- for block in section.blocks -%}
              <button
                type="button"
                class="hungers-column__item-container{% if forloop.first %} is-active{% endif %}"
                data-image="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2400 }}{% endif %}"
                data-heading="{{ block.settings.title | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="hungers-column__item">{{ block.settings.title }}</span>
                <template data-description>{{ block.settings.desc }}</template>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% style %}
  #HungersColumn-{{ section.id }} {
    width: 100%;
    padding: var(--hc-padding-top) 0 var(--hc-padding-bottom);
    overflow: hidden;
    color: var(--hc-text-color);
    background: var(--hc-section-bg);
  }

  #HungersColumn-{{ section.id }} .hungers-column__container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--hc-gap);
    width: 100%;
  }

  #HungersColumn-{{ section.id }} .hungers-column__image,
  #HungersColumn-{{ section.id }} .hungers-column__content {
    min-width: 0;
    min-height: 62rem;
    border-radius: var(--radius-card, 15px);
    overflow: hidden;
  }

  #HungersColumn-{{ section.id }} .hungers-column__image img,
  #HungersColumn-{{ section.id }} .hungers-column__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  #HungersColumn-{{ section.id }} .hungers-column__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4rem;
    padding: 3rem 2rem 2rem;
    background: var(--hc-content-bg);
    text-align: left;
  }

  #HungersColumn-{{ section.id }} .hungers-column__top {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  #HungersColumn-{{ section.id }} .hungers-column__heading {
    margin: 0;
    color: var(--hc-heading-color);
    font-size: var(--hc-heading-desktop);
    font-weight: 700;
    line-height: 1.2;
    text-transform: lowercase;
    transition: opacity 0.3s ease;
  }

  #HungersColumn-{{ section.id }} .hungers-column__desc {
    max-width: 60rem;
    color: var(--hc-text-color);
    font-size: var(--hc-text-desktop);
    line-height: 1.6;
    transition: opacity 0.3s ease;
  }

  #HungersColumn-{{ section.id }} .hungers-column__desc > * {
    margin-block: 0;
  }

  #HungersColumn-{{ section.id }} .hungers-column__bottom {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    border-top: 0.1rem solid color-mix(in srgb, var(--hc-text-color), transparent 72%);
  }

  #HungersColumn-{{ section.id }} .hungers-column__item-container {
    display: flex;
    width: 100%;
    min-height: 7rem;
    align-items: center;
    padding: 1.8rem 0;
    border: 0;
    border-bottom: 0.1rem solid color-mix(in srgb, var(--hc-text-color), transparent 72%);
    border-radius: 0;
    color: var(--hc-text-color);
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  #HungersColumn-{{ section.id }} .hungers-column__item {
    font-size: var(--hc-item-desktop);
    font-weight: 700;
    opacity: 0.62;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  #HungersColumn-{{ section.id }} .hungers-column__item-container.is-active .hungers-column__item {
    color: var(--hc-heading-color);
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    #HungersColumn-{{ section.id }} .hungers-column__item-container:hover {
      background: transparent;
    }

    #HungersColumn-{{ section.id }} .hungers-column__item-container:hover .hungers-column__item {
      color: var(--hc-hover-color);
      transform: translateX(0.4rem);
    }
  }

  #HungersColumn-{{ section.id }} .hungers-column__item-container:focus-visible {
    outline: 0.2rem solid var(--hc-hover-color);
    outline-offset: 0.2rem;
  }

  @media screen and (max-width: 749px) {
    #HungersColumn-{{ section.id }} .hungers-column__container {
      grid-template-columns: 1fr;
    }

    #HungersColumn-{{ section.id }} .hungers-column__image,
    #HungersColumn-{{ section.id }} .hungers-column__content {
      min-height: 0;
    }

    #HungersColumn-{{ section.id }} .hungers-column__image {
      aspect-ratio: 1 / 1;
    }

    #HungersColumn-{{ section.id }} .hungers-column__content {
      align-items: flex-start;
      padding: 3rem 2rem 2rem;
      text-align: left;
    }

    #HungersColumn-{{ section.id }} .hungers-column__heading {
      font-size: var(--hc-heading-mobile);
    }

    #HungersColumn-{{ section.id }} .hungers-column__desc {
      font-size: var(--hc-text-mobile);
    }

    #HungersColumn-{{ section.id }} .hungers-column__item-container {
      min-height: 5rem;
      padding: 1.4rem 0;
    }

    #HungersColumn-{{ section.id }} .hungers-column__item {
      font-size: var(--hc-item-mobile);
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById('HungersColumn-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;

    const items = section.querySelectorAll('.hungers-column__item-container');
    const mainImage = section.querySelector('.hungers-column__main-image');
    const mainHeading = section.querySelector('[data-main-heading]');
    const mainDescription = section.querySelector('[data-main-description]');
    let changeTimer;

    const changeContent = (item) => {
      const image = item.dataset.image;
      const heading = item.dataset.heading;
      const description = item.querySelector('[data-description]');

      window.clearTimeout(changeTimer);
      if (mainImage && image) mainImage.style.opacity = '0';
      if (mainHeading) mainHeading.style.opacity = '0';
      if (mainDescription) mainDescription.style.opacity = '0';

      changeTimer = window.setTimeout(() => {
        if (mainImage && image) {
          mainImage.removeAttribute('srcset');
          mainImage.src = image;
          mainImage.style.opacity = '1';
        }
        if (mainHeading && heading) {
          mainHeading.textContent = heading;
          mainHeading.style.opacity = '1';
        }
        if (mainDescription && description) {
          mainDescription.innerHTML = description.innerHTML;
          mainDescription.style.opacity = '1';
        }
        items.forEach((entry) => entry.classList.toggle('is-active', entry === item));
      }, 300);
    };

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => changeContent(item));
      item.addEventListener('click', () => changeContent(item));
    });

    section.dataset.initialized = 'true';
  })();
</script>

{% schema %}
{
  "name": "Hungers Column",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Default image" },
    { "type": "text", "id": "heading", "label": "Main heading", "default": "Our Values" },
    { "type": "richtext", "id": "desc_1", "label": "Default description", "default": "<p>It was important to us to build a value-driven business. At Hungers, we believe in simplicity, affordability, authenticity, quality, and transparency.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "content_background", "label": "Content background", "default": "#f1f0ed" },
    { "type": "color", "id": "item_background", "label": "Item background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#333333" },
    { "type": "color", "id": "hover_color", "label": "Hover color", "default": "#000000" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size_desktop", "min": 18, "max": 72, "step": 2, "unit": "px", "label": "Desktop heading size", "default": 32 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 48, "step": 2, "unit": "px", "label": "Mobile heading size", "default": 26 },
    { "type": "range", "id": "text_size_desktop", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Desktop text size", "default": 18 },
    { "type": "range", "id": "text_size_mobile", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Mobile text size", "default": 15 },
    { "type": "range", "id": "item_size_desktop", "min": 14, "max": 40, "step": 1, "unit": "px", "label": "Desktop item size", "default": 26 },
    { "type": "range", "id": "item_size_mobile", "min": 12, "max": 30, "step": 1, "unit": "px", "label": "Mobile item size", "default": 20 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "column_gap", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Space between columns", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding", "default": 4 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "blocks": [
    {
      "type": "value_item",
      "name": "Value item",
      "settings": [
        { "type": "text", "id": "title", "label": "Item title", "default": "Our Values" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "richtext", "id": "desc", "label": "Description", "default": "<p>Write the description for this value item.</p>" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hungers Column",
      "category": "Custom sections",
      "blocks": [
        { "type": "value_item" },
        { "type": "value_item" },
        { "type": "value_item" }
      ]
    }
  ]
}
{% endschema %}
