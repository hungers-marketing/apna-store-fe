{%- liquid
  assign left_count = section.blocks.size | plus: 1 | divided_by: 2
-%}

<div class="rounded-section">
  <section
    id="HungersFaqs-{{ section.id }}"
    class="hungers-faqs rounded-section__inner"
    aria-labelledby="HungersFaqsTitle-{{ section.id }}"
    style="--faq-section-background: {{ section.settings.section_background }}; --faq-container-background: {{ section.settings.container_background }}; --faq-item-background: {{ section.settings.item_background }}; --faq-answer-background: {{ section.settings.answer_background }}; --faq-heading-color: {{ section.settings.heading_color }}; --faq-text-color: {{ section.settings.text_color }}; --faq-answer-color: {{ section.settings.answer_color }}; --faq-icon-color: {{ section.settings.icon_color }}; --faq-border-color: {{ section.settings.border_color }}; --faq-heading-size: {{ section.settings.heading_size }}px; --faq-question-size: {{ section.settings.question_size }}px; --faq-answer-size: {{ section.settings.answer_size }}px; --faq-container-radius: {{ section.settings.container_radius }}px; --faq-container-padding-desktop: {{ section.settings.container_padding_desktop }}px; --faq-container-padding-mobile: {{ section.settings.container_padding_mobile }}px; --faq-padding-top: {{ section.settings.padding_top }}px; --faq-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="hungers-faqs__inner">
      {%- if section.settings.heading != blank -%}
        <h2 id="HungersFaqsTitle-{{ section.id }}" class="hungers-faqs__title">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="hungers-faqs__container">
        <div class="hungers-faqs__column">
          {%- for block in section.blocks limit: left_count -%}
            {%- render 'hungers-faq-item', block: block, section_id: section.id -%}
          {%- endfor -%}
        </div>

        <div class="hungers-faqs__column">
          {%- for block in section.blocks offset: left_count -%}
            {%- render 'hungers-faq-item', block: block, section_id: section.id -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% style %}
  #HungersFaqs-{{ section.id }} {
    width: 100%;
    padding-block: var(--faq-padding-top) var(--faq-padding-bottom);
    overflow: hidden;
    color: var(--faq-text-color);
    background: var(--faq-section-background);
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__inner {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    padding: var(--faq-container-padding-desktop);
    border-radius: var(--faq-container-radius);
    background: var(--faq-container-background);
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__title {
    margin: 0 0 4rem;
    color: var(--faq-heading-color);
    font-size: var(--faq-heading-size);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1.5rem;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__item {
    overflow: hidden;
    border: 0.1rem solid var(--faq-border-color);
    border-radius: var(--radius-card, 8px);
    background: var(--faq-item-background);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__item.is-active {
    box-shadow: 0 0.4rem 1.4rem rgba(0, 0, 0, 0.05);
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__question {
    display: flex;
    width: 100%;
    min-height: 5.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 2rem;
    border: 0;
    color: var(--faq-text-color);
    background: transparent;
    font: inherit;
    font-size: var(--faq-question-size);
    font-weight: 500;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__icon {
    flex: 0 0 auto;
    color: var(--faq-icon-color);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__item.is-active .hungers-faqs__icon {
    transform: rotate(45deg);
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__question:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: -0.4rem;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__answer {
    padding: 0 2rem 1.5rem;
    color: var(--faq-answer-color);
    background: var(--faq-answer-background);
    font-size: var(--faq-answer-size);
    line-height: 1.5;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__answer[hidden] {
    display: none;
  }

  #HungersFaqs-{{ section.id }} .hungers-faqs__answer p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #HungersFaqs-{{ section.id }} .hungers-faqs__inner {
      padding: var(--faq-container-padding-mobile);
    }

    #HungersFaqs-{{ section.id }} .hungers-faqs__title {
      margin-bottom: 2.4rem;
    }

    #HungersFaqs-{{ section.id }} .hungers-faqs__container {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    #HungersFaqs-{{ section.id }} .hungers-faqs__question {
      min-height: 5.2rem;
      padding: 1.5rem 1.6rem;
    }

    #HungersFaqs-{{ section.id }} .hungers-faqs__answer {
      padding: 0 1.6rem 1.5rem;
    }
  }
{% endstyle %}

<script>
  (() => {
    const initFaqs = (root = document) => {
      const section = root.id && root.id.startsWith('HungersFaqs-') ? root : root.querySelector?.('#HungersFaqs-{{ section.id }}');
      if (!section || section.dataset.initialized === 'true') return;

      const questions = section.querySelectorAll('.hungers-faqs__question');

      const closeItem = (item) => {
        const question = item.querySelector('.hungers-faqs__question');
        const answer = item.querySelector('.hungers-faqs__answer');
        item.classList.remove('is-active');
        question.setAttribute('aria-expanded', 'false');
        answer.hidden = true;
      };

      questions.forEach((question) => {
        question.addEventListener('click', () => {
          const item = question.closest('.hungers-faqs__item');
          const answer = item.querySelector('.hungers-faqs__answer');
          const shouldOpen = question.getAttribute('aria-expanded') !== 'true';

          section.querySelectorAll('.hungers-faqs__item.is-active').forEach((openItem) => {
            if (openItem !== item) closeItem(openItem);
          });

          if (shouldOpen) {
            item.classList.add('is-active');
            question.setAttribute('aria-expanded', 'true');
            answer.hidden = false;
          } else {
            closeItem(item);
          }
        });
      });

      section.dataset.initialized = 'true';
    };

    initFaqs();
    document.addEventListener('shopify:section:load', (event) => initFaqs(event.target));
  })();
</script>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hungers FAQs",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Frequently Asked Questions" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "container_background", "label": "Main container background", "default": "#f7f6f3" },
    { "type": "color", "id": "item_background", "label": "Question background", "default": "#fdfcf9" },
    { "type": "color", "id": "answer_background", "label": "Answer background", "default": "#fffefb" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#333333" },
    { "type": "color", "id": "text_color", "label": "Question color", "default": "#333333" },
    { "type": "color", "id": "answer_color", "label": "Answer color", "default": "#555555" },
    { "type": "color", "id": "icon_color", "label": "Plus icon color", "default": "#333333" },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#f5f3ef" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "min": 14, "max": 48, "step": 1, "unit": "px", "label": "Heading size", "default": 18 },
    { "type": "range", "id": "question_size", "min": 12, "max": 28, "step": 1, "unit": "px", "label": "Question size", "default": 16 },
    { "type": "range", "id": "answer_size", "min": 12, "max": 24, "step": 1, "unit": "px", "label": "Answer size", "default": 16 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "container_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Container corner radius", "default": 10 },
    { "type": "range", "id": "container_padding_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Desktop container padding", "default": 40 },
    { "type": "range", "id": "container_padding_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Mobile container padding", "default": 20 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Bottom padding", "default": 20 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Sample question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Your answer text goes here." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Hungers FAQs",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
