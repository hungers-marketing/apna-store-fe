{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact-form-upload.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="contact contact--support-form page-width section-{{ section.id }}-padding"
    style="--contact-form-width: {{ section.settings.form_width }}px; --contact-field-height: {{ section.settings.field_height }}px; --contact-field-radius: {{ section.settings.field_radius }}px;"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class, enctype: 'multipart/form-data' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact-support__fields">
        <div class="contact-support__field">
          <label class="visually-hidden" for="ContactForm-name">First and Last Name</label>
          <input
            class="contact-support__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[name]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="First and Last Name*"
            required
          >
        </div>

        <div class="contact-support__field field--with-error">
          <label class="visually-hidden" for="ContactForm-email">Email</label>
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="contact-support__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="Email*"
            required
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>

        <div class="contact-support__field contact-support__select-wrap">
          <label class="visually-hidden" for="ContactForm-reason">Contact Reason</label>
          <select id="ContactForm-reason" class="contact-support__input contact-support__select" name="contact[Contact reason]" required>
            <option value="" disabled selected>Contact Reason*</option>
            {%- assign contact_reasons = section.settings.contact_reasons | newline_to_br | split: '<br />' -%}
            {%- for reason in contact_reasons -%}
              {%- assign clean_reason = reason | strip -%}
              {%- if clean_reason != blank -%}
                <option value="{{ clean_reason | escape }}">{{ clean_reason }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>

        <div class="contact-support__field">
          <label class="visually-hidden" for="ContactForm-topic">Topic</label>
          <input type="text" id="ContactForm-topic" class="contact-support__input" name="contact[Topic]" placeholder="Topic*" required>
        </div>

        <div class="contact-support__field">
          <label class="visually-hidden" for="ContactForm-body">Tell us the details</label>
          <textarea
            rows="8"
            id="ContactForm-body"
            class="contact-support__input contact-support__textarea"
            name="contact[body]"
            placeholder="Tell us the details.*"
            required
          >{{- form.body -}}</textarea>
        </div>

        {%- if section.settings.show_upload -%}
          <div class="contact-support__upload-group" data-contact-upload>
            <p class="contact-support__upload-note">(Optional: 10 files max, total file size must be less than 50MB)</p>
            <label class="contact-support__upload" for="ContactForm-files">
              <span class="contact-support__upload-copy">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="4" width="18" height="16" rx="1.5" stroke="currentColor"/>
                  <circle cx="8.5" cy="9" r="1.5" fill="currentColor"/>
                  <path d="m5 18 4.5-4.5 3 3 2.5-2.5 4 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Drag or paste image here</span>
              </span>
              <span class="contact-support__upload-action">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M12 15V3m0 0L8 7m4-4 4 4M5 13v6h14v-6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Upload
              </span>
              <input
                id="ContactForm-files"
                class="contact-support__file-input"
                type="file"
                name="contact[Attachments]"
                accept="image/*,.pdf"
                multiple
                data-contact-file-input
              >
            </label>
            <p class="contact-support__file-status" data-contact-file-status aria-live="polite"></p>
          </div>
        {%- endif -%}
      </div>
      <div class="contact__button">
        <button type="submit" class="button">
          SUBMIT
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Form style"
    },
    {
      "type": "range",
      "id": "form_width",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Form width",
      "default": 600
    },
    {
      "type": "range",
      "id": "field_height",
      "min": 44,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Field height",
      "default": 56
    },
    {
      "type": "range",
      "id": "field_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Field corner radius",
      "default": 12
    },
    {
      "type": "textarea",
      "id": "contact_reasons",
      "label": "Contact reasons (one per line)",
      "default": "Order status\nCancel or modify an order\nReturns or exchanges\nMy order is missing\nMy order arrived damaged\nIssue with my product\nShipping questions\nProduct questions\nPartnerships / collaboration\nWholesale requests\nOther / general inquiry"
    },
    {
      "type": "checkbox",
      "id": "show_upload",
      "label": "Show file upload",
      "info": "Note: Standard Shopify contact forms do not natively process email attachments. Integrate a third-party upload app or webhook if you require receiving uploaded files.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
